.inventory-root {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
}

.inventory-wheel {
    position: relative;
    width: 420px;
    height: 420px;
    border-radius: 210px;
    background-color: rgba(10, 10, 10, 0.55);
    border-width: 3px;
    border-color: rgba(210, 210, 210, 0.35);
}

.inventory-slot {
    position: absolute;
    width: 86px;
    height: 86px;
    border-radius: 43px;
    background-color: rgba(25, 25, 25, 0.95);
    border-width: 2px;
    border-color: rgba(230, 230, 230, 0.35);
    align-items: center;
    justify-content: center;
}

.inventory-slot:hover {
    background-color: rgba(80, 80, 80, 0.95);
    border-color: rgba(255, 255, 255, 0.8);
}

.slot-number {
    color: rgb(230, 230, 230);
    unity-font-style: bold;
    font-size: 24px;
}

.inventory-center {
    position: absolute;
    left: 145px;
    top: 145px;
    width: 130px;
    height: 130px;
    border-radius: 65px;
    background-color: rgba(5, 5, 5, 0.95);
    border-width: 2px;
    border-color: rgba(230, 230, 230, 0.4);
    align-items: center;
    justify-content: center;
}

.center-text {
    color: rgb(235, 235, 235);
    font-size: 20px;
    unity-font-style: bold;
}

/* 8 revolver-style positions */

.slot-top {
    left: 167px;
    top: 18px;
}

.slot-top-right {
    left: 272px;
    top: 62px;
}

.slot-right {
    left: 316px;
    top: 167px;
}

.slot-bottom-right {
    left: 272px;
    top: 272px;
}

.slot-bottom {
    left: 167px;
    top: 316px;
}

.slot-bottom-left {
    left: 62px;
    top: 272px;
}

.slot-left {
    left: 18px;
    top: 167px;
}

.slot-top-left {
    left: 62px;
    top: 62px;
}